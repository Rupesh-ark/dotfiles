// Zed settings: synced via github.com/Rupesh-ark/dotfiles (zed/).
// Defaults are documented at https://zed.dev/docs/configuring-zed
{
  // AI agent: same model as before the 2026-11-18 reset.
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
