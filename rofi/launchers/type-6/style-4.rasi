/**
 * Gruvbox Rofi Theme
 * Based on adi1090x type-6, reworked for Gruvbox Dark
 */

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               " Apps";
    display-run:                " Run";
    display-filebrowser:        " Files";
    display-window:             " Windows";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

/*****----- Gruvbox Palette -----*****/
* {
    font:                        "JetBrains Mono Nerd Font 11";

    bg0:                         #1d2021;
    bg0-soft:                    #282828;
    bg1:                         #3c3836;
    bg2:                         #504945;
    bg3:                         #665c54;
    fg0:                         #fbf1c7;
    fg1:                         #ebdbb2;
    fg4:                         #a89984;
    red:                         #fb4934;
    green:                       #b8bb26;
    yellow:                      #fabd2f;
    blue:                        #83a598;
    purple:                      #d3869b;
    aqua:                        #8ec07c;
    orange:                      #fe8019;

    background:                  @bg0;
    background-alt:              @bg1;
    foreground:                  @fg1;
    selected:                    @orange;
    active:                      @green;
    urgent:                      @red;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       1000px;
    x-offset:                    0px;
    y-offset:                    0px;
    enabled:                     true;
    border:                      2px solid;
    border-color:                @bg2;
    border-radius:               16px;
    cursor:                      "default";
    background-color:            @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
    orientation:                 horizontal;
    children:                    [ "imagebox", "listbox" ];
}

imagebox {
    padding:                     20px;
    background-color:            transparent;
    background-image:            url("~/.config/rofi/images/d.png", height);
    orientation:                 vertical;
    children:                    [ "inputbar", "dummy", "mode-switcher" ];
}

listbox {
    spacing:                     15px;
    padding:                     20px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}

dummy {
    background-color:            transparent;
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     12px 15px;
    border:                      0px 0px 2px 0px;
    border-color:                @orange;
    border-radius:               10px;
    background-color:            @bg1;
    text-color:                  @foreground;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "";
    background-color:            inherit;
    text-color:                  @orange;
    padding:                     2px;
}

entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           @fg4;
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    enabled:                     true;
    spacing:                     15px;
    background-color:            transparent;
    text-color:                  @foreground;
}

button {
    padding:                     12px;
    border-radius:               10px;
    background-color:            @bg1;
    text-color:                  @fg4;
    cursor:                      pointer;
}

button selected {
    background-color:            @orange;
    text-color:                  @bg0;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     5px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     15px;
    padding:                     8px 12px;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            inherit;
    text-color:                  inherit;
}

element normal.urgent {
    background-color:            @urgent;
    text-color:                  @bg0;
}

element normal.active {
    background-color:            @active;
    text-color:                  @bg0;
}

element selected.normal {
    background-color:            @orange;
    text-color:                  @bg0;
}

element selected.urgent {
    background-color:            @red;
    text-color:                  @bg0;
}

element selected.active {
    background-color:            @green;
    text-color:                  @bg0;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  inherit;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        28px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Message -----*****/
message {
    background-color:            transparent;
}

textbox {
    padding:                     12px;
    border-radius:               10px;
    background-color:            @bg1;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

error-message {
    padding:                     15px;
    border-radius:               16px;
    background-color:            @background;
    text-color:                  @foreground;
}
